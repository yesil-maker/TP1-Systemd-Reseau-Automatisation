[Unit]
Description=Portail de suivi Helios
After=network.target
PartOf=helios.target

[Service]
Type=simple

User=helios-suivi
Group=helios-suivi

ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /srv/helios/suivi/www

Restart=on-failure
RestartSec=5s

MemoryMax=128M
CPUQuota=50%

NoNewPrivileges=yes
PrivateTmp=yes

ProtectSystem=strict
ProtectHome=yes

ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes

RestrictSUIDSGID=yes

PrivateDevices=yes

LockPersonality=yes
MemoryDenyWriteExecute=yes

ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes

RestrictNamespaces=yes
RestrictRealtime=yes

SystemCallArchitectures=native

CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target